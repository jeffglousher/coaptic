          <mxGeometry x="760" y="150" width="310" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="heur" value="Reference starting heuristic&lt;br&gt;&lt;b&gt;B = Incoming Body Slots + Outgoing Body Slots&lt;/b&gt;&lt;br&gt;RX = RX_base + B&lt;br&gt;TX = TX_base + B" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="410" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="measure" value="Measurement / tuning&lt;br&gt;platform packet rate • CPU • socket/network stack • loss/RTT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="485" width="410" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sat" value="At saturation&lt;br&gt;bounded state machines continue fair passes&lt;br&gt;errors / timeout / refusal / packet loss may occur&lt;br&gt;memory and work-per-pass remain bounded" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="650" width="550" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bodycount" target="heur">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="dgramcount" target="heur">
