          <mxGeometry x="785" y="510" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="fsm" value="General lifetime rule&lt;br&gt;&lt;b&gt;Every occupied slot/entry has explicit retention and release/terminal conditions.&lt;/b&gt;&lt;br&gt;Timing stays with that owner when required." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="490" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="pnote" value="No traffic priorities. No private overflow queue. No universal global pass order. Protocol-specific state machines and timers remain in the applicable IETF specifications." style="shape=note;whiteSpace=wrap;html=1;size=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
