        <mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="measure" target="sat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="The heuristic is not a correctness formula. Datagram Slots remain shared. Smaller Datagram pools are valid when stronger pacing/isolation is intentional." style="shape=note;whiteSpace=wrap;html=1;size=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="455" width="300" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="Adding Body Slots does not prove the platform can advance all bodies concurrently at full rate. Defaults must be validated against the useful socket rate." style="shape=note;whiteSpace=wrap;html=1;size=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="455" width="290" height="135" as="geometry"/>
