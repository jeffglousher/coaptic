; Fixed, canonical CBOR v1. Public metadata; no key custody or rollback claim.
; The decoder rejects nonminimal integers, extra items and trailing bytes.
pairing-record = [
  version: 1, store: bstr .size 32, revision: 1..18446744073709551615,
  local_principal: bstr .size 32, peer: (bstr .size 65 / null),
  peer_kid: 0..255, owner: bstr .size 32, permissions: bstr .size 32,
  enabled: bool
]
; Unpaired: revision1, peer=null, kid0, zero owner/permissions, enabled=false.
; Paired/revoked: revision>=2, valid peer, nonzero owner and permissions.
pairing-challenge = [
  version: 1, device: bstr .size 65, kid: 0..255, store: bstr .size 32,
  revision: 1..18446744073709551615, record_digest: bstr .size 32,
  nonce: bstr .size 32
]
pairing-update = [
  version: 1, action: (0 / 1), challenge: bstr .cbor pairing-challenge,
  peer: bstr .size 65, kid: 0..255,
  owner: bstr .size 32, permissions: bstr .size 32
]
; 0 grants, 1 revokes the identical retained policy. Privileged local channel only.
commissioning-request = [1, 0] / [1, 1, kid: 0..255] / [1, 2] /
  [1, 3, update: bstr .cbor pairing-update, ipv4_port: bstr .size 6] / [1, 4]
commissioning-reply = [1, 129] /
  [1, 128, device: bstr .size 65, kid: 0..255, record: bstr .cbor pairing-record] /
  [1, 130, challenge: bstr .cbor pairing-challenge] /
  [1, 131, committed: bstr .cbor pairing-record] / [1, 132] / [1, 255, refusal: 0..255]
; Serial frame: h'00435001', two-byte big-endian length(1..512), exact CBOR payload.
